# ========================================================
# CASA MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env and configure real credentials.
# Do NOT commit your production .env file to version control.

# Core Server Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Persistence (MongoDB Atlas or Local replica set)
MONGODB_URI=mongodb://127.0.0.1:27017/casa

# Security & Authentication
JWT_SECRET=casa_super_secret_jwt_key_2026_dev_secure

# --------------------------------------------------------
# External Gateway 1: Razorpay India (Payments)
# --------------------------------------------------------
# Obtain from: https://dashboard.razorpay.com/#/app/keys
# If left as placeholders, CaSa runs in deterministic sandbox mode.
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# --------------------------------------------------------
# External Gateway 2: Logistics / Courier API (Optional)
# --------------------------------------------------------
# If not configured, CaSa operates native dedicated in-house delivery fleet
COURIER_API_ENDPOINT=https://apiv2.shiprocket.in/v1/external
COURIER_API_TOKEN=placeholder_courier_api_token

# --------------------------------------------------------
# External Gateway 3: SMS / Doorstep OTP Service (Optional)
# --------------------------------------------------------
# Providers: twilio | msg91 | fast2sms
# In dev/sandbox mode, OTPs are surfaced in order status records for testing
SMS_PROVIDER=fast2sms
SMS_API_KEY=placeholder_sms_api_key
SMS_SENDER_ID=CASAIN

# --------------------------------------------------------
# External Gateway 4: Email / SMTP Notifications (Optional)
# --------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=placeholder_smtp_pass
EMAIL_FROM=no-reply@casa.in

# --------------------------------------------------------
# External Gateway 5: Media Cloud Storage (Optional)
# --------------------------------------------------------
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder
